{
  // AWS account number
  "account": "12345678",
  // region
  "region": "us-east-1",
  // application DNS domain
  "domainName": "indigo.example.com",
  // existing VPC where application will run
  "vpc": "vpc-12345678",
  // created resources will use these security groups
  "securityGroups": [ "sg-12345678", "sg-12345678" ],
  // ssh key pair that will be used by created EC2 instances
  "ec2KeyPair": "ec2_key_pair",
  // DNS hosted zone
  "hostedZone": "Z12345678",
  // DNS hosted zone name
  "hostedZoneName": "example.com",
  // lambda deployment and S3 gateway will use these subnets
  "lambdaSubnets": [ "subnet-1234", "subnet-5678" ],
  // created S3 bucket name
  "storageBucketName": "indigoeln-data-dev",
  // availability zone where data volume is created
  "dataVolumeAz": "us-east-1a",
  // shall it create S3 Gateway in VPC; if multiple environments share the same VPC, only one shall have createS3Gateway as others will just reuse it
  "createS3Gateway": true,
  // images to use; adjust version or use private ECR repository if building a custom version;
  // the following images are valid for 3.0 release:
  "postgresImage": "public.ecr.aws/m5k0g6n7/indigoeln/postgres-combined:3.0.0",
  "elnAwsImage": "public.ecr.aws/m5k0g6n7/indigoeln/eln-aws:3.0.0",
  "reportsAwsImage": "public.ecr.aws/m5k0g6n7/indigoeln/reports-aws:3.0.0",
  "signatureAwsImage": "public.ecr.aws/m5k0g6n7/indigoeln/signature-aws:3.0.0",
  "sampleRegistrationAwsImage": "public.ecr.aws/m5k0g6n7/indigoeln/sampleregistration-aws:3.0.0"
}
